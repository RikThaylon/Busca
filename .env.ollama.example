# Local semantic DEMO. Install/download models before disconnecting from the network.
POSTGRES_PASSWORD=replace-with-random-hex
APP_MODE=demo
APP_ORIGIN=http://localhost:8080
SECURE_COOKIE=false
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
# Optional selector: qwen3:4b; blank keeps literal evidence without a generator.
CHAT_MODEL=
MIN_SIMILARITY=0.55
RETENTION_DAYS=30
