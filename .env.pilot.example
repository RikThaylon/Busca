# Mandatory before real customer data: review docs/SECURITY.md and acceptance gates.
POSTGRES_PASSWORD=replace-with-random-hex
APP_MODE=pilot
APP_ORIGIN=https://docs.example.internal
SECURE_COOKIE=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_KEY=replace-with-fernet-key
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
CHAT_MODEL=
MIN_SIMILARITY=0.55
EXTERNAL_AI_APPROVED=false
RETENTION_DAYS=30
