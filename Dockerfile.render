FROM node:22-alpine AS frontend-build
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app

COPY backend/app ./app
COPY demo /demo
COPY --from=frontend-build /build/frontend/dist ./static

USER appuser
EXPOSE 10000

CMD ["sh", "-c", "export APP_ORIGIN=\"${APP_ORIGIN:-${RENDER_EXTERNAL_URL:-http://localhost:10000}}\"; if [ \"${APP_MODE:-demo}\" = \"demo\" ]; then python -m app.cli demo; else python -m app.cli init; fi; exec python -m uvicorn app.render:app --host 0.0.0.0 --port \"${PORT:-10000}\" --no-access-log --workers 1"]
